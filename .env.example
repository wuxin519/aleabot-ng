# ===== AleaBot NG 配置文件 =====
# 复制为 .env 并按需修改

# ---------- 通用 ----------
# 数据目录与数据库文件（默认 ./data/aleabot.db）
ALEABOT_DATA_DIR=./data
# ALEABOT_DB=./data/aleabot.db
# 备份目录（默认 ./data/backups）
# ALEABOT_BACKUP_DIR=./data/backups
# 管理员 ID（多个用英文逗号分隔；QQ 填 QQ 号，KOOK 填用户 ID）
ADMIN_IDS=

# ---------- 网页管理后台 ----------
# 监听端口
WEB_PORT=8787
# 管理口令（留空则无需鉴权，公网部署务必设置）
ADMIN_TOKEN=

# ---------- 自动备份 ----------
# 备份间隔（小时），设为 0 关闭自动备份
BACKUP_INTERVAL_HOURS=24
# 保留备份份数
BACKUP_KEEP=14

# ---------- QQ（OneBot 11）----------
# 是否启用
ONEBOT_ENABLED=false
# OneBot 正向 WebSocket 地址（NapCat 默认 3001；go-cqhttp 默认 6700）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 若 OneBot 配置了 access_token，填在这里
ONEBOT_TOKEN=

# ---------- KOOK ----------
# 是否启用
KOOK_ENABLED=false
# KOOK 机器人 Token（开放平台 → 机器人 → Token）
KOOK_TOKEN=
